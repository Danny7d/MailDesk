# MailDesk web app (v1). Copy to .env and fill in.
# The v2 workspace has its own example at apps/.env.example.

# Runtime database URL.
# Supabase: use the TRANSACTION pooler (port 6543) and keep the two params below.
# Local Postgres: a plain URL is fine, e.g. postgresql://user:pass@localhost:5432/maildesk
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=3"

# Used for migrations (prisma.config.ts). Supabase session pooler / direct connection (port 5432).
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Generate each with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret"
ENCRYPTION_KEY="your-encryption-key"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# MailDesk's own Resend key, used for inbound email (separate from users' keys).
RESEND_API_KEY="re_xxxxxxxxx"
RESEND_WEBHOOK_SECRET="whsec_xxxxxxxxx"
MAILDESK_INBOUND_DOMAIN="your-inbound-domain.resend.app"
