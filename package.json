    "dev:legacy": "next dev",
    "build:legacy": "next build",
    "start:legacy": "next start"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dependency-cruiser": "^16.6.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "turbo": "^2.4.0",
    "typescript": "^5",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^13.4.1",
    "next": "^16.3.6",
    "next-auth": "^4.24.15",
    "prisma": "^5.20.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.28.1",
    "zod": "^4.6.5"
  }
